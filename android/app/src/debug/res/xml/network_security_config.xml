<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG BUILDS ONLY. This file lives in the `debug` source set, so the manifest
  merger never applies it to a release APK and `bun run release:verify` keeps
  asserting that releases carry no cleartext permission.

  Android 9+ blocks cleartext by default, which would stop a debug build from
  reaching a local update service. `adb reverse tcp:8080 tcp:8080` maps the
  handset's own 127.0.0.1:8080 onto the development machine, so only loopback
  needs an exemption — no LAN address, and nothing routable from outside the
  cable.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
